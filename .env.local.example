# Ejemplo de configuracion local para tool/server.py
#
# Copiar a .env.local y ajustar la contrasena:
#   copy .env.local.example .env.local
#
# .env.local esta en .gitignore: no se sube al repositorio.

# El proxy (/proxy-sql) prefiere la version UNPOOLED, porque abre y cierra
# una conexion por request. Con pooling se acumulan conexiones ociosas
# contra la base local.
DATABASE_URL_UNPOOLED=postgresql://control_app:CAMBIAR_ESTA_CONTRASENA@localhost:5432/control_entradas?sslmode=disable
DATABASE_URL=postgresql://control_app:CAMBIAR_ESTA_CONTRASENA@localhost:5432/control_entradas?sslmode=disable

# Token que valida /proxy-sql en el header X-Proxy-Token.
#
# OBLIGATORIO en cuanto el servidor quede exposed (por ejemplo, detras de un
# tunel de Cloudflare). Sin este valor el proxy responde 401 y NO ejecuta
# ninguna consulta, incluido el modo web.
#
# Es el mismo valor que hay que pegar en la app, en
# Ajustes -> Base de datos -> Proxy HTTPS -> Token del proxy.
#
# Generar uno:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# OJO: quien tenga el token puede ejecutar cualquier SQL sobre la base.
PROXY_SQL_TOKEN=CAMBIAR_ESTE_TOKEN

# sslmode=disable porque el trafico entre la PC servidor y los dispositivos
# ya viaja cifrado por Tailscale. No cambiar a require: la base local no
# tiene TLS configurado.
