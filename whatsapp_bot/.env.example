# Archivo de configuracion del bot. Copiar como .env y completar.
# Esta en .gitignore: nunca subirlo.

# Token de GitHub para publicar la URL del tunel en el Gist.
# El nombre tiene que ser exacto, asi lo leen el bot y el lanzador de la API.
# Se genera en https://github.com/settings/tokens con permiso de escritura
# sobre Gists: classic con el scope "gist", o fine-grained con "Gists: write".
# Verificar que serve:  node tool\diagnostico_gist.js
GITHUB_TOKEN=ghp_aqui_va_tu_token

# Clave de la API de Gemini, si el bot la usa.
# GEMINI_API_KEY=ai_aqui_va_la_clave

# Conexion a PostgreSQL para el recordatorio de compras sin validar.
# Es la misma base local que usa tool/server.py (localhost:5432). Conviene
# un rol dedicado con SELECT en movimientos, productos y pos_settings, y
# escritura solo en pos_settings (marcas de ultimo aviso y textos del panel).
# Si no esta, el recordatorio se apaga y el bot sigue enviando todo lo demas.
# DATABASE_URL=postgresql://usuario:clave@localhost:5432/control_entradas
