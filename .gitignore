# Logs
*.log
server.log

# graphify cache (regenerable con `graphify update .`)
graphify-out/

# Environment files
.env
.env.local
*.env.*
# ...pero los ejemplos si se versionan, para poder partir de ellos.
!.env.local.example
!.env.example

# Local databases (runtime, regeneradas al arrancar)
*.db
*.db-shm
*.db-wal
*.sqlite

# Python venv del proxy SQL (tool/server.py)
/tool/venv/

# Dart: paquete separado de tool/ para correr `dart test` sin Flutter.
# El pubspec.yaml si se versiona; el lock y el cache, no.
/tool/.dart_tool/
/tool/pubspec.lock

# Miscellaneous
*.class
*.pyc
*.pyo
__pycache__/
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# flutter_app legacy (todo el código fuente está en raíz lib/)
flutter_app/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Android signing
android/release.jks
android/release.p12
android/key.properties

# Artefactos locales que NO son codigo fuente.
pg_hba_*.txt

# Herramientas de migracion: secretos y respaldos con datos reales.
# `tool/.pgpass_tmp` guarda la contrasena del rol postgres en texto plano: es
# lo que permite aplicar las migraciones que hacen RENAME (exigen ser dueno de
# la tabla). Nunca al repo.
tool/.pgpass_tmp
# `tool/respaldos/` son dumps de las tablas de produccion: nombres de
# operadores, PINs hasheados y device_ids. No se versionan.
tool/respaldos/

# Bot de WhatsApp: dependencias, sesion autenticada y binarios.
# `whatsapp_bot/auth/` guarda las credenciales de WhatsApp Web (Baileys):
# es lo que evita tener que pasar el QR de nuevo, y sube al repo es filtrar la
# sesion de la cuenta.
/whatsapp_bot/node_modules/
/whatsapp_bot/auth/
# Copias de la sesion en subcarpetas del bot (ej: "Nueva carpeta") filtran la
# misma credencial: la regla de arriba, anclada, no las cubre.
/whatsapp_bot/*/auth/
/whatsapp_bot/cloudflared.exe
# config.json SI se versiona (tiene grupos y puertos, no secretos).
